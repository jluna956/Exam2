<!-- file contains item card template , which will display each media item -->
<a href="/items/<%= item.id %>" class="card item-card">
    <div class="cover" style="background: <%= item.cover %>">
        <span class="badge badge-<%= item.type.toLowerCase() %>"><%= item.type %></span>
    </div>
    <div class="card-body">
        <h3 class="card-title"><%= item.title %></h3>
        <p class="muted"><%= item.creator %> · <%= item.releaseYear %></p>
        <p class="muted small"><%= item.genreName %></p>
        <p class="rating">
        <% if (item.ratingCount > 0) { %>
            ★ <%= item.averageRating.toFixed(1) %>
            <span class="muted small">(<%= item.ratingCount %> rating<%= item.ratingCount === 1 ? "" : "s" %>)</span>
        <% } else { %>
            <span class="muted small">No ratings yet</span>
        <% } %>
        </p>
    </div>
</a>
